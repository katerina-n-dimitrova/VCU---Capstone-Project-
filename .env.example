# Copy to .env.local and edit. Every value is optional.

# 'mock' = simulated data, no hardware needed. 'live' = talk to the ESP32.
# Defaults: mock for `npm run dev`, live for `npm run build`.
VITE_DATA_SOURCE=mock

# Show the orange demo / simulation controls.
# Defaults: true in dev, false in a production build.
VITE_SIMULATION_CONTROLS=true

# Where the ESP32 HTTP + WebSocket server lives.
# Leave empty when the ESP32 serves the app itself (same origin).
# Set this when running `npm run dev` on a laptop connected to the vehicle hotspot.
VITE_API_BASE_URL=http://192.168.4.1

# Connection tuning (milliseconds)
VITE_REQUEST_TIMEOUT_MS=6000
VITE_SOCKET_SILENCE_MS=5000
VITE_REST_POLL_MS=15000

# Map tile source. Only reachable when the browser has internet access.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Shown on the System Status page.
VITE_APP_VERSION=0.1.0-dev
